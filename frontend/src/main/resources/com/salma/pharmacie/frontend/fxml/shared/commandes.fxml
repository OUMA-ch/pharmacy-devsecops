<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salma.pharmacie.frontend.controller.shared.CommandeControllerFX">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Gestion des Commandes" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <Button text="Afficher" onAction="#loadCommandes"/>
        <Button text="Nouvelle commande" onAction="#handleAddCommande"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
    </HBox>

    <TableView fx:id="commandeTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="Num Cmd" prefWidth="80"/>
            <TableColumn fx:id="dateCol" text="Date" prefWidth="130"/>
            <TableColumn fx:id="statutCol" text="Statut" prefWidth="150"/>
            <TableColumn fx:id="fournisseurCol" text="Fournisseur ID" prefWidth="140"/>
            <TableColumn fx:id="actionsCol" text="Actions" prefWidth="220"/>
        </columns>
    </TableView>

    <Label text="Lignes de commande" style="-fx-font-weight: bold;"/>

    <TableView fx:id="ligneTable" prefHeight="180">
        <columns>
            <TableColumn fx:id="produitIdCol" text="Produit ID" prefWidth="160"/>
            <TableColumn fx:id="qteCol" text="Quantité demandée" prefWidth="160"/>
        </columns>
    </TableView>

</VBox>
