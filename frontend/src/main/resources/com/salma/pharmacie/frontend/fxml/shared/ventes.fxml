<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.salma.pharmacie.frontend.controller.shared.VenteControllerFX">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Gestion des Ventes" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <Label text="Client ID:"/>
        <TextField fx:id="clientIdField" prefWidth="100" promptText="ex: 1"/>

        <Button text="Afficher" onAction="#loadVentes"/>
        <Button text="Nouvelle vente" onAction="#handleAddVente"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
    </HBox>

    <TableView fx:id="venteTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="60"/>
            <TableColumn fx:id="dateCol" text="Date" prefWidth="120"/>
            <TableColumn fx:id="produitCol" text="Produit ID" prefWidth="100"/>
            <TableColumn fx:id="quantiteCol" text="Quantité" prefWidth="90"/>
            <TableColumn fx:id="prixTotalCol" text="Prix Total" prefWidth="120"/>
            <TableColumn fx:id="ordonnanceCol" text="Ordonnance ID" prefWidth="120"/>
            <TableColumn fx:id="ordMedecinCol" text="Médecin" prefWidth="140"/>
            <TableColumn fx:id="ordDateCol" text="Date émission" prefWidth="120"/>
            <TableColumn fx:id="ordDescCol" text="Description" prefWidth="200"/>
            <TableColumn fx:id="actionsCol" text="Actions" prefWidth="160"/>
        </columns>
    </TableView>
</VBox>
