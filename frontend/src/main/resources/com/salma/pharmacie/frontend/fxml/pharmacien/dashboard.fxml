<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.salma.pharmacie.frontend.controller.pharmacien.PharmacienDashboardController"
            prefWidth="1000" prefHeight="700">
    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50;" prefWidth="200">
            <padding><Insets top="20" right="10" bottom="20" left="10"/></padding>

            <Button text="Produits" onAction="#showProduits" maxWidth="Infinity" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Button text="Ventes" onAction="#showVentes" maxWidth="Infinity" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Button text="Commandes" onAction="#showCommandes" maxWidth="Infinity" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Button text="Fournisseurs" onAction="#showFournisseurs" maxWidth="Infinity" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Déconnexion" onAction="#handleLogout" maxWidth="Infinity" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <Label text="Bienvenue Pharmacien"/>
        </StackPane>
    </center>
</BorderPane>
