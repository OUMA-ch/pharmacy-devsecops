<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.salma.pharmacie.frontend.controller.responsable.ResponsableDashboardController"
            prefWidth="1100" prefHeight="720">

    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50;" prefWidth="220">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>

            <Label text="Responsable"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>

            <Separator/>

            <Button text="Produits" onAction="#showProduits" maxWidth="Infinity"
                    style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Button text="Ventes" onAction="#showVentes" maxWidth="Infinity"
                    style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Button text="Commandes" onAction="#showCommandes" maxWidth="Infinity"
                    style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Button text="Fournisseurs" onAction="#showFournisseurs" maxWidth="Infinity"
                    style="-fx-background-color: #34495e; -fx-text-fill: white;"/>

            <Separator/>

            <Button text="Gestion Pharmaciens" onAction="#showPharmaciens" maxWidth="Infinity"
                    style="-fx-background-color: #16a085; -fx-text-fill: white;"/>
            <Button text="Rapports" onAction="#showRapports" maxWidth="Infinity"
                    style="-fx-background-color: #16a085; -fx-text-fill: white;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Déconnexion" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <Label text="Bienvenue (Responsable)" style="-fx-font-size: 18;"/>
        </StackPane>
    </center>

</BorderPane>
